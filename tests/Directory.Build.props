<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- xunit.v3 test projects are self-executing Microsoft.Testing.Platform hosts. -->
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <!-- Test assemblies are not a public API surface. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!--
      Test assemblies are never packed or published, so deterministic source paths buy nothing
      here — and they actively hurt: CI stack traces come back as "/_/tests/..." instead of real
      files, and anything reading [CallerFilePath] gets a placeholder that points nowhere.
    -->
    <DeterministicSourcePaths>false</DeterministicSourcePaths>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!--
      Coverage comes from the Microsoft.Testing.Platform extension rather than coverlet.collector:
      coverlet's collector runs under VSTest, which the .NET 10 SDK no longer supports for xunit.v3.
    -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
