<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Build / packaging">
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <!--
    Microsoft.Extensions.* deliberately pinned to the 8.0.x line: it is the lowest version
    carrying everything the SDK needs and it runs fine on net10.0, so a net8.0 consumer is
    never forced to lift their Extensions graph just to reference this package.
  -->
  <ItemGroup Label="Runtime (EFactura.Net.Client only)">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <!--
    xunit.v3 runs on Microsoft.Testing.Platform. The .NET 10 SDK dropped VSTest support for it,
    so there is deliberately no Microsoft.NET.Test.Sdk / xunit.runner.visualstudio here —
    adding either puts `dotnet test` back on the unsupported VSTest path.
  -->
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
